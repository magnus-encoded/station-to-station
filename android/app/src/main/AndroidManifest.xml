<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reading gallery photos taken on the night of the show, to offer them as
         the playlist cover. Android 13 split this out of storage; 14 added the
         "selected photos only" grant. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- Adding a planned gig to the calendar (#55). WRITE inserts the event; READ
         finds a calendar to write it to. Requested at swipe time, not on launch —
         a denial degrades to a toast, not a crash. Unlike ACTION_INSERT this returns
         the event's id, so the gig screen can keep a tappable link to it. -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- The night's facts, parked in the shade while setlist.fm's form is filled in
         (see data/Filing.kt). The form takes no prefill parameters and the clipboard
         holds one thing, so the shade is the only surface that stays in reach of the
         browser. Requested at publish time, and a denial degrades to exactly the old
         behaviour: songs on the clipboard, form opens. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- #18 BLE probe: raw GATT is the only framework that bridges iOS<->Android
         (see #13), so this is what the field-test data has to come from. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Two users, one permission. Nearby Connections needs location to scan on 32
         and below (on 33+ the neverForLocation flags on BLUETOOTH_SCAN and
         NEARBY_WIFI_DEVICES stand in for it). #33's check-in needs it on every
         version — one foreground fix when the timeline is opened, which is why the
         maxSdkVersion that used to be here is gone.
         Deliberately NOT declared: ACCESS_BACKGROUND_LOCATION. Nothing in this app
         asks where the phone is while it is closed, and adding that permission is a
         privacy commitment nobody has decided to make. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!--
      Backup stays on: the friends list and the setlist.fm username are worth keeping
      across a reinstall. The bearer secrets are not in it — both rule files exclude
      the credentials DataStore, and minSdk 26 means both are live (dataExtractionRules
      from API 31, fullBackupContent for 26-30).
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StationToStation">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- One scheme for everything now: station-to-station. No host attribute,
                 so ANY authority under it matches — the router (MainActivity) tells the
                 deep links apart by authority:
                   station-to-station://callback         Spotify OAuth redirect
                   station-to-station://friend?u=…&sid=…&name=…   friend card exchange
                   station-to-station://gig?id=…         a gig invite from a contact
                   station-to-station://handover?h=…&amp;p=…&amp;f=…&amp;k=…  the old phone's QR
                   station-to-station://<gig>            the setlist itself
                   station-to-station://<user>/<gig>     that line, scrolled to the gig
                   station-to-station://Friends/<gig>    the woven view, scrolled to it -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="station-to-station" />
            </intent-filter>
            <!-- Belt-and-suspenders: the old setlist2spotify scheme is still accepted so
                 friend cards and OAuth redirects shared before the rename keep resolving.
                 The app no longer emits these; it only still answers them. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="setlist2spotify"
                    android:host="callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="setlist2spotify"
                    android:host="friend" />
            </intent-filter>
            <!-- A PDF ticket shared from an email or wallet app's own share sheet (#411),
                 handled by MainActivity's handleTicketIntent, the sibling of the deep-link
                 handler above rather than a rewrite of it. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- A tap on a filing notification copies that one value and nothing else.
             Deliberately a receiver rather than an activity: an activity would bring
             the app to the front and throw the Historian out of the half-filled
             setlist.fm form, which is the exact thing the shade exists to avoid. -->
        <receiver
            android:name=".data.CopyReceiver"
            android:exported="false" />

        <!-- Photo-picker uris only grant us read access for the current process — gone
             on relaunch, which is why keepsakes went blank. Gig photos are copied into
             gig_photos/ (see PhotoRepository.persistCopy) and re-exposed through this. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
