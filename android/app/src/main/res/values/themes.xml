<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ground under everything, so no frame of the launch is the platform's grey. -->
    <style name="Theme.StationToStation" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>

    <!-- The launch splash: the mark on Ground, kept up by MainActivity until the
         timeline it opens to is ready. -->
    <style name="Theme.StationToStation.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.StationToStation</item>
    </style>
</resources>
