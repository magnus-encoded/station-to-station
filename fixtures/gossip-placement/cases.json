[
  {"name": "they have a song before my first row",
   "mine": ["song2", "song3"],
   "theirs": {"amanda": {"0": "song1", "1": "song2", "2": "song3"}},
   "expected": [
     {"base": null, "lines": ["amanda:0"]},
     {"base": 0, "lines": ["amanda:1"]},
     {"base": 1, "lines": ["amanda:2"]}]},
  {"name": "my Gap takes the line next to the anchor and the earlier line gets its own row",
   "mine": ["", "song3"],
   "theirs": {"amanda": {"0": "song1", "1": "song2", "2": "song3"}},
   "expected": [
     {"base": null, "lines": ["amanda:0"]},
     {"base": 0, "lines": ["amanda:1"]},
     {"base": 1, "lines": ["amanda:2"]}]},
  {"name": "a Gap between two anchors takes the line between them",
   "mine": ["song2", "", "song4"],
   "theirs": {"amanda": {"0": "song2", "1": "song3", "2": "song4"}},
   "expected": [
     {"base": 0, "lines": ["amanda:0"]},
     {"base": 1, "lines": ["amanda:1"]},
     {"base": 2, "lines": ["amanda:2"]}]},
  {"name": "field test: a late line 0 lands on my Gap, not after my Log",
   "mine": ["", "Song 2", "Song 3"],
   "theirs": {"amanda": {"0": "song1"}},
   "expected": [
     {"base": 0, "lines": ["amanda:0"]},
     {"base": 1, "lines": []},
     {"base": 2, "lines": []}]},
  {"name": "field test: line 2 with holes lands on row 3 whatever else arrived",
   "mine": ["song1", "song2", "Song three", "song 4"],
   "theirs": {"amanda": {"2": "Song 3"}},
   "expected": [
     {"base": 0, "lines": []},
     {"base": 1, "lines": []},
     {"base": 2, "lines": ["amanda:2"]},
     {"base": 3, "lines": []}]},
  {"name": "a tombstoned number collapses and the later numbers move up",
   "mine": ["song1", "song2", "Song three", "song 4"],
   "theirs": {"amanda": {"1": "", "2": "Song 3"}},
   "expected": [
     {"base": 0, "lines": []},
     {"base": 1, "lines": ["amanda:2"]},
     {"base": 2, "lines": []},
     {"base": 3, "lines": []}]},
  {"name": "more of their lines than my rows between two anchors become rows of their own",
   "mine": ["A", "x", "B"],
   "theirs": {"amanda": {"0": "A", "1": "p", "2": "q", "3": "r", "4": "B"}},
   "expected": [
     {"base": 0, "lines": ["amanda:0"]},
     {"base": 1, "lines": ["amanda:1"]},
     {"base": null, "lines": ["amanda:2"]},
     {"base": null, "lines": ["amanda:3"]},
     {"base": 2, "lines": ["amanda:4"]}]},
  {"name": "fewer of their lines than my rows between two anchors leave my rows bare",
   "mine": ["A", "x", "y", "z", "B"],
   "theirs": {"amanda": {"0": "A", "2": "p", "4": "B"}},
   "expected": [
     {"base": 0, "lines": ["amanda:0"]},
     {"base": 1, "lines": []},
     {"base": 2, "lines": ["amanda:2"]},
     {"base": 3, "lines": []},
     {"base": 4, "lines": ["amanda:4"]}]},
  {"name": "after the last anchor lines run top-down and the excess follows my Log",
   "mine": ["A", "x"],
   "theirs": {"amanda": {"0": "A", "1": "p", "2": "q", "3": "r"}},
   "expected": [
     {"base": 0, "lines": ["amanda:0"]},
     {"base": 1, "lines": ["amanda:1"]},
     {"base": null, "lines": ["amanda:2"]},
     {"base": null, "lines": ["amanda:3"]}]},
  {"name": "with no anchor line n lands on row n and lines past my Log follow it",
   "mine": ["a", "b"],
   "theirs": {"amanda": {"1": "x", "2": "y"}},
   "expected": [
     {"base": 0, "lines": []},
     {"base": 1, "lines": ["amanda:1"]},
     {"base": null, "lines": ["amanda:2"]}]},
  {"name": "a second author is woven over the rows the first one made",
   "mine": ["song2"],
   "theirs": {
     "amanda": {"0": "song1", "1": "song2"},
     "bo": {"0": "song1", "1": "song2", "2": "song3"}},
   "expected": [
     {"base": null, "lines": ["amanda:0", "bo:0"]},
     {"base": 0, "lines": ["amanda:1", "bo:1"]},
     {"base": null, "lines": ["bo:2"]}]}
]
